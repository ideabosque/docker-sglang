# ===== Model selection (HuggingFace Hub repo id or local path inside the cache) =====
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# ===== HuggingFace =====
# Required for gated/private models. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
# Set to 1 to use hf_transfer for faster downloads (image must include it)
HF_HUB_ENABLE_HF_TRANSFER=1

# ===== Host paths =====
# Directory on the host where HuggingFace models will be cached/stored.
# Maps to /root/.cache/huggingface inside the container.
MODELS_DIR=./models

# ===== Networking =====
HOST_PORT=30000

# ===== SGLang runtime =====
SGLANG_IMAGE_TAG=latest
TP_SIZE=1
DTYPE=auto
MEM_FRACTION_STATIC=0.88
CONTEXT_LENGTH=8192
