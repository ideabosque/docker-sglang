# ===== Model selection (HuggingFace Hub repo id or local path inside the cache) =====
MODEL_ID=Qwen/Qwen3-4B

# ===== HuggingFace =====
# Required for gated/private models. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
# Set to 1 to use hf_transfer for faster downloads (image must include it)
HF_HUB_ENABLE_HF_TRANSFER=1

# ===== Host paths =====
# Directory on the host where HuggingFace models will be cached/stored.
# Maps to /root/.cache/huggingface inside the container.
MODELS_DIR=./models

# ===== Networking =====
HOST_PORT=30000

# ===== SGLang runtime =====
SGLANG_IMAGE_TAG=latest
TP_SIZE=1
DTYPE=auto
MEM_FRACTION_STATIC=0.88
CONTEXT_LENGTH=8192

# ===== Parsers (leave blank to disable) =====
# Enables OpenAI-style structured tool_calls in responses.
#   qwen          -> Qwen2.5 / Qwen3 (non-coder)
#   qwen3_coder   -> Qwen3-Coder
#   mistral       -> Mistral
#   llama3        -> Llama 3.x
#   pythonic      -> generic python-style
TOOL_CALL_PARSER=qwen

# Separates <think>...</think> reasoning into `reasoning_content`.
#   qwen3         -> Qwen3 family
#   deepseek_r1   -> DeepSeek-R1
REASONING_PARSER=qwen3
